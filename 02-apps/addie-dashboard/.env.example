# Copy to .env.local (never commit the filled-in file).
# Anything VITE_-prefixed is inlined into the public browser bundle — only put
# values there that are safe to publish.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only: read by netlify/functions/anthropic.mjs, never sent to the
# browser. Set it in Netlify under Site configuration > Environment variables.
ANTHROPIC_API_KEY=
